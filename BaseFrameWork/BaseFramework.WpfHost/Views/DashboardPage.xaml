<UserControl x:Class="BaseFramework.WpfHost.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BaseFramework.WpfHost.Controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="8"
                Padding="8">
            <controls:ObjectInspectorControl x:Name="Inspector" />
        </Border>

        <GridSplitter Grid.Column="1"
                      Margin="2,0"
                      Background="{StaticResource SurfaceBrush}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ShowsPreview="True" />

        <controls:CalendarControl Grid.Column="2"
                                  x:Name="Schedule"
                                  EventsSource="{Binding ScheduledItems}"
                                  Margin="12,0,0,0" />
    </Grid>
</UserControl>
