<UserControl x:Class="DocumentAutomation.App.Views.DesignerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Template Designer"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Inspect template registrations and refresh placeholder definitions from a real .docx file."
                           Opacity="0.72"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Rescan Selected Template"
                    VerticalAlignment="Bottom"
                    Click="OnRescanClicked" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <ListBox x:Name="TemplateList"
                         DisplayMemberPath="Name"
                         SelectionChanged="OnTemplateSelectionChanged" />
            </Border>

            <Border Grid.Column="1"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TemplateSummaryText"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1"
                              x:Name="FieldGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding FieldKey}" Width="*" />
                            <DataGridTextColumn Header="Display" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired}" Width="Auto" />
                            <DataGridTextColumn Header="Suggested Source" Binding="{Binding SuggestedSource}" Width="Auto" />
                            <DataGridTextColumn Header="DB Key" Binding="{Binding DatabaseKey}" Width="*" />
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="Auto" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               x:Name="DesignerStatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
