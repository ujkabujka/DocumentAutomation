<UserControl x:Class="DocumentAutomation.App.Views.DocumentGenerationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BaseFramework.Wpf.Controls;assembly=BaseFramework.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#1F1F26"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Project"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="ProjectSelector"
                              Width="260"
                              DisplayMemberPath="ProjectCode" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0">
                    <TextBlock Text="Template"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="TemplateSelector"
                              Width="280"
                              DisplayMemberPath="Name" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Prepare"
                        Margin="12,20,0,0"
                        Click="OnPrepareClicked" />
                <Button Grid.Column="3"
                        Content="Save Persistable Fields"
                        Margin="12,20,0,0"
                        Click="OnSaveFieldsClicked" />
                <Button Grid.Column="4"
                        Content="Generate Document"
                        Margin="12,20,0,0"
                        Click="OnGenerateClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <controls:ObjectInspectorControl x:Name="FieldInspector" />
            </Border>

            <Border Grid.Column="1"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Prepared Field Snapshot"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1"
                              x:Name="PreparedFieldGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" />
                            <DataGridCheckBoxColumn Header="Missing" Binding="{Binding IsMissing}" Width="Auto" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               x:Name="GenerationStatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.78" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
