<UserControl x:Class="DocumentAutomation.App.Views.AdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Administration"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Text="Manage users, roles, and assignments."
                       Opacity="0.72"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <DataGrid x:Name="UsersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionChanged="OnUserSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="*" />
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Roles"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="RolesList"
                             DisplayMemberPath="Name"
                             MinHeight="200" />
                    <Button Content="Assign Selected Role"
                            Margin="0,12,0,0"
                            Click="OnAssignRoleClicked" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#1F1F26"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Selected User Roles"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="AssignedRolesText"
                               TextWrapping="Wrap"
                               Opacity="0.82" />
                    <TextBlock x:Name="AdminStatusText"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.72" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
