<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocumentAutomation.Application\DocumentAutomation.Application.csproj" />
    <ProjectReference Include="..\DocumentAutomation.Infrastructure\DocumentAutomation.Infrastructure.csproj" />
    <ProjectReference Include="..\DocumentAutomation.Word\DocumentAutomation.Word.csproj" />
    <ProjectReference Include="..\..\BaseFrameWork\BaseFramework.Core\BaseFramework.Core.csproj" />
    <ProjectReference Include="..\..\BaseFrameWork\BaseFramework.Wpf\BaseFramework.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>
</Project>
